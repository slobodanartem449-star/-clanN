<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Официальный сайт Клана</title>
    <link href="https://fonts.googleapis.com/css2?family=Rajdhani:wght@500;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-color: #050508;
            --card-bg: rgba(18, 20, 28, 0.75);
            --primary: #a855f7;
            --primary-glow: rgba(168, 85, 247, 0.4);
            --accent: #ec4899;
            --text-main: #e2e8f0;
            --text-muted: #94a3b8;
            --border-color: rgba(168, 85, 247, 0.2);
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Inter', sans-serif;
        }

        body {
            background-color: var(--bg-color);
            color: var(--text-main);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            overflow-x: hidden;
            position: relative;
        }

        /* Анимированный фоновый градиент и сетка */
        body::before {
            content: '';
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            background: 
                radial-gradient(circle at 10% 20%, rgba(168, 85, 247, 0.12) 0%, transparent 40%),
                radial-gradient(circle at 90% 80%, rgba(236, 72, 153, 0.08) 0%, transparent 40%),
                linear-gradient(to bottom, #050508, #0b0c16);
            z-index: -2;
        }

        /* Плавающие световые шары */
        .glow-orb {
            position: fixed;
            width: 400px;
            height: 400px;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(168, 85, 247, 0.15) 0%, transparent 70%);
            z-index: -1;
            filter: blur(60px);
            animation: floatOrb 10s ease-in-out infinite alternate;
        }
        .glow-orb:nth-child(2) {
            top: 60%; right: -100px;
            background: radial-gradient(circle, rgba(236, 72, 153, 0.12) 0%, transparent 70%);
            animation-delay: -5s;
        }

        @keyframes floatOrb {
            0% { transform: translateY(0) scale(1); }
            100% { transform: translateY(-40px) scale(1.1); }
        }

        header {
            text-align: center;
            padding: 60px 20px 30px;
            max-width: 800px;
        }

        h1 {
            font-family: 'Rajdhani', sans-serif;
            font-size: 3.5rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 3px;
            background: linear-gradient(135deg, #fff 30%, var(--primary) 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            text-shadow: 0 0 30px var(--primary-glow);
            margin-bottom: 15px;
        }

        .subtitle {
            color: var(--text-muted);
            font-size: 1.1rem;
            margin-bottom: 25px;
        }

        .server-ip-box {
            display: inline-flex;
            align-items: center;
            gap: 12px;
            background: rgba(20, 22, 35, 0.8);
            border: 1px solid var(--border-color);
            padding: 12px 24px;
            border-radius: 50px;
            cursor: pointer;
            backdrop-filter: blur(10px);
            box-shadow: 0 4px 20px rgba(0,0,0,0.4), inset 0 0 10px rgba(168, 85, 247, 0.1);
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            margin-bottom: 25px;
        }

        .server-ip-box:hover {
            border-color: var(--primary);
            transform: translateY(-2px);
            box-shadow: 0 6px 25px var(--primary-glow);
        }

        .server-ip-box span {
            color: #fff;
            font-weight: 600;
            letter-spacing: 1px;
            font-family: 'Rajdhani', sans-serif;
            font-size: 1.2rem;
        }

        .copy-icon {
            font-size: 0.9rem;
            color: var(--primary);
        }

        .social-links {
            display: flex;
            gap: 15px;
            justify-content: center;
            flex-wrap: wrap;
        }

        .btn-social {
            background: rgba(25, 28, 42, 0.8);
            color: white;
            padding: 12px 22px;
            border-radius: 12px;
            text-decoration: none;
            font-weight: 600;
            font-size: 0.95rem;
            border: 1px solid rgba(255, 255, 255, 0.08);
            backdrop-filter: blur(10px);
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .btn-social.discord:hover {
            background: #5865F2;
            border-color: #5865F2;
            box-shadow: 0 0 20px rgba(88, 101, 242, 0.4);
            transform: translateY(-2px);
        }

        .btn-social.telegram:hover {
            background: #2AABEE;
            border-color: #2AABEE;
            box-shadow: 0 0 20px rgba(42, 171, 238, 0.4);
            transform: translateY(-2px);
        }

        .main-container {
            max-width: 950px;
            width: 90%;
            background: var(--card-bg);
            border-radius: 24px;
            padding: 45px;
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6);
            border: 1px solid var(--border-color);
            backdrop-filter: blur(20px);
            margin-bottom: 60px;
        }

        /* Навигация по вкладкам правил */
        .tabs {
            display: flex;
            gap: 15px;
            margin-bottom: 30px;
            border-bottom: 1px solid rgba(255,255,255,0.08);
            padding-bottom: 15px;
        }

        .tab-btn {
            background: transparent;
            border: none;
            color: var(--text-muted);
            font-size: 1.1rem;
            font-weight: 600;
            cursor: pointer;
            padding: 8px 16px;
            border-radius: 8px;
            transition: 0.3s;
        }

        .tab-btn.active {
            color: #fff;
            background: rgba(168, 85, 247, 0.15);
            box-shadow: inset 0 0 10px rgba(168, 85, 247, 0.2);
        }

        .tab-content {
            display: none;
        }

        .tab-content.active {
            display: block;
            animation: fadeIn 0.4s ease;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(6px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .rules-grid {
            display: grid;
            grid-template-columns: 1fr;
            gap: 14px;
        }

        .rule-card {
            background: rgba(12, 14, 22, 0.6);
            padding: 16px 20px;
            border-radius: 14px;
            border: 1px solid rgba(255, 255, 255, 0.04);
            border-left: 4px solid var(--primary);
            display: flex;
            align-items: flex-start;
            gap: 15px;
            transition: all 0.3s ease;
        }

        .rule-card:hover {
            transform: translateX(6px);
            background: rgba(20, 23, 36, 0.9);
            border-color: rgba(168, 85, 247, 0.3);
            box-shadow: 0 4px 20px rgba(0,0,0,0.3);
        }

        .rule-number {
            font-family: 'Rajdhani', sans-serif;
            color: var(--primary);
            font-weight: 700;
            font-size: 1.2rem;
            min-width: 40px;
        }

        .rule-text {
            color: var(--text-main);
            font-size: 1rem;
            line-height: 1.5;
        }

        /* Форма заявки */
        .apply-section {
            margin-top: 50px;
            border-top: 1px dashed rgba(168, 85, 247, 0.3);
            padding-top: 40px;
        }

        .apply-section h2 {
            font-family: 'Rajdhani', sans-serif;
            font-size: 2rem;
            color: #fff;
            margin-bottom: 8px;
        }

        .apply-subtitle {
            color: var(--text-muted);
            margin-bottom: 25px;
            font-size: 0.95rem;
        }

        .form-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
            margin-bottom: 20px;
        }

        @media(max-width: 768px) {
            .form-grid { grid-template-columns: 1fr; }
            h1 { font-size: 2.5rem; }
            .main-container { padding: 25px; }
        }

        .form-group label {
            display: block;
            margin-bottom: 8px;
            color: var(--text-main);
            font-weight: 500;
            font-size: 0.9rem;
        }

        .form-group input {
            width: 100%;
            padding: 14px 18px;
            background: rgba(10, 12, 18, 0.8);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 12px;
            color: white;
            font-size: 1rem;
            outline: none;
            transition: all 0.3s ease;
        }

        .form-group input:focus {
            border-color: var(--primary);
            box-shadow: 0 0 15px var(--primary-glow);
            background: rgba(15, 18, 28, 0.9);
        }

        .btn-submit {
            background: linear-gradient(135deg, #a855f7, #ec4899);
            color: white;
            border: none;
            padding: 16px;
            font-size: 1.05rem;
            font-weight: 600;
            border-radius: 12px;
            cursor: pointer;
            width: 100%;
            transition: all 0.3s ease;
            box-shadow: 0 4px 20px rgba(168, 85, 247, 0.4);
            text-transform: uppercase;
            letter-spacing: 1px;
            font-family: 'Rajdhani', sans-serif;
        }

        .btn-submit:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 25px rgba(236, 72, 153, 0.5);
        }

        #status-msg {
            margin-top: 15px;
            text-align: center;
            font-weight: 500;
            font-size: 0.95rem;
        }

        footer {
            margin-top: auto;
            padding: 30px;
            text-align: center;
            font-size: 0.85rem;
            color: var(--text-muted);
            border-top: 1px solid rgba(255,255,255,0.05);
            width: 100%;
        }
    </style>
</head>
<body>

    <div class="glow-orb"></div>
    <div class="glow-orb"></div>

    <header>
        <h1>Элитный Клан</h1>
        <p class="subtitle">Свод правил, устоев и система вступления в наш состав</p>
        
        <div class="server-ip-box" onclick="copyIP()" title="Нажмите, чтобы скопировать IP">
            <span>IP: ru.hypemc.pro</span>
            <span class="copy-icon">📋 Клик для копирования</span>
        </div>

        <div class="social-links">
            <a href="https://discord.gg/JKPt35XZMd" target="_blank" class="btn-social discord">🎮 Discord Сервер</a>
            <a href="https://t.me/+yRE6yxzVpXM0MTEy" target="_blank" class="btn-social telegram">📢 Telegram Канал</a>
        </div>
    </header>

    <div class="main-container">
        <!-- Навигация по правилам -->
        <div class="tabs">
            <button class="tab-btn active" onclick="switchTab('main-rules', this)">⚔️ Основные правила</button>
            <button class="tab-btn" onclick="switchTab('punishments', this)">⚖️ Условия и покарания</button>
        </div>

        <!-- Вкладка 1 -->
        <div id="main-rules" class="tab-content active">
            <div class="rules-grid">
                <div class="rule-card">
                    <div class="rule-number">1.0</div>
                    <div class="rule-text">Запрещено брать любые вещи без предварительного разрешения главных участников.</div>
                </div>
                <div class="rule-card">
                    <div class="rule-number">1.1</div>
                    <div class="rule-text">Если вам необходима помощь в игре — немедленно обращайтесь к главным или соклановцам.</div>
                </div>
                <div class="rule-card">
                    <div class="rule-number">1.2</div>
                    <div class="rule-text">Каждый участник обязан поддерживать высокий уровень навыков в PvP.</div>
                </div>
                <div class="rule-card">
                    <div class="rule-number">1.3</div>
                    <div class="rule-text">Строго запрещено шуметь, устраивать конфликты, оскорблять и использовать мат.</div>
                </div>
                <div class="rule-card">
                    <div class="rule-number">1.4</div>
                    <div class="rule-text">Категорический запрет на спам в чатах клана и беседе.</div>
                </div>
                <div class="rule-card">
                    <div class="rule-number">1.5</div>
                    <div class="rule-text">Главный состав имеет полное право исключить игрока за нарушение правил. Правила едины для всех!</div>
                </div>
            </div>
        </div>

        <!-- Вкладка 2 -->
        <div id="punishments" class="tab-content">
            <div class="rules-grid">
                <div class="rule-card">
                    <div class="rule-number">2.0</div>
                    <div class="rule-text">При нарушении правила игрок обязан честно признаться. Система наказаний вариативна.</div>
                </div>
                <div class="rule-card">
                    <div class="rule-number">2.1</div>
                    <div class="rule-text">Если у вас не хватает ресурсов для развития — это не проблема, соклановцы всегда помогут и поделятся.</div>
                </div>
                <div class="rule-card">
                    <div class="rule-number">2.2</div>
                    <div class="rule-text">Наличие рабочего Telegram или Discord для связи — строго обязательное условие.</div>
                </div>
                <div class="rule-card">
                    <div class="rule-number">2.3</div>
                    <div class="rule-text">Отсутствие активности при голосовании или в игре без предупреждения расценивается как игнор, за что предусмотрены строгие санкции.</div>
                </div>
                <div class="rule-card">
                    <div class="rule-number">2.4</div>
                    <div class="rule-text">Возрастной ценз для вступления в клан: строго от 10 до 16 лет.</div>
                </div>
                <div class="rule-card">
                    <div class="rule-number">2.5</div>
                    <div class="rule-text">Прогрессия наказаний: 1) Кик из клана; 2) Лишение ресурсной поддержки; 3) Игнорирование или грубое отношение со стороны участников.</div>
                </div>
            </div>
        </div>

        <!-- Форма заявки -->
        <div class="apply-section">
            <h2>Подать заявку на вступление</h2>
            <p class="apply-subtitle">Заполните анкету ниже, и ваша заявка мгновенно поступит на рассмотрение руководству в Telegram.</p>
            
            <form id="applyForm" onsubmit="sendApplication(event)">
                <div class="form-grid">
                    <div class="form-group">
                        <label for="minecraftNick">Ваш ник в Minecraft:</label>
                        <input type="text" id="minecraftNick" required placeholder="Например: kongik34">
                    </div>
                    <div class="form-group">
                        <label for="playerAge">Ваш возраст (от 10 до 16 лет):</label>
                        <input type="number" id="playerAge" min="10" max="16" required placeholder="Например: 14">
                    </div>
                </div>
                <button type="submit" class="btn-submit">Отправить заявку в клан</button>
                <div id="status-msg"></div>
            </form>
        </div>
    </div>

    <footer>
        &copy; 2026 Clan Management System. All rights reserved.
    </footer>

    <script>
        // Переключение вкладок правил
        function switchTab(tabId, btn) {
            document.querySelectorAll('.tab-content').forEach(el => el.classList.remove('active'));
            document.querySelectorAll('.tab-btn').forEach(el => el.classList.remove('active'));
            
            document.getElementById(tabId).classList.add('active');
            btn.classList.add('active');
        }

        // Копирование IP
        function copyIP() {
            navigator.clipboard.writeText("ru.hypemc.pro");
            alert("✨ IP сервера успешно скопирован: ru.hypemc.pro");
        }

        // Интеграция с Telegram Bot (my_kenderino_bot)
        const BOT_TOKEN = "8971311574:AAEpk9FWC_LlZ5hoDm0eLtaisIOW4fcxyOQ";
        const CHAT_ID = "-1002345678901"; // Замените на числовой ID вашего Telegram-канала

        async function sendApplication(event) {
            event.preventDefault();
            const nick = document.getElementById('minecraftNick').value;
            const age = document.getElementById('playerAge').value;
            const statusMsg = document.getElementById('status-msg');

            statusMsg.style.color = "var(--text-muted)";
            statusMsg.innerHTML = "⏳ Шифрование и отправка заявки...";

            const text = `⚔️ <b>Новая элитная заявка в клан!</b>\n\n👤 <b>Ник:</b> ${nick}\n📅 <b>Возраст:</b> ${age} лет`;
            
            const keyboard = {
                inline_keyboard: [
                    [
                        { text: "✅ Принять игрока", callback_data: `accept_${nick}` }
                    ]
                ]
            };

            try {
                const response = await fetch(`https://api.telegram.org/bot${BOT_TOKEN}/sendMessage`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        chat_id: CHAT_ID,
                        text: text,
                        parse_mode: 'HTML',
                        reply_markup: keyboard
                    })
                });

                const data = await response.json();
                if (data.ok) {
                    statusMsg.style.color = "#34d399";
                    statusMsg.innerHTML = "🚀 Заявка успешно отправлена руководству!";
                    document.getElementById('applyForm').reset();
                } else {
                    statusMsg.style.color = "#f43f5e";
                    statusMsg.innerHTML = "⚠️ Ошибка отправки. Проверьте ID канала в коде.";
                }
            } catch (error) {
                statusMsg.style.color = "#f43f5e";
                statusMsg.innerHTML = "❌ Ошибка соединения с сервером Telegram.";
            }
            
            setTimeout(() => {
                statusMsg.innerHTML = "";
            }, 6000);
        }
    </script>
</body>
</html>
